{%- comment -%}
  App embed "Personalizer core": loads the widget JS/CSS once per page.
  Assets are generated by `npm run build:widget`; do not edit them by hand.
{%- endcomment -%}
{{ 'personalizer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'personalizer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Personalizer core",
  "target": "body",
  "settings": []
}
{% endschema %}
